# Pay-When-Done environment. Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Render internal URL in production)
DATABASE_URL=
# Better Auth signing secret, at least 32 random characters
BETTER_AUTH_SECRET=
# Public base URL Better Auth uses for cookies and origin checks
BETTER_AUTH_URL=
# "true" enables the demo role switcher and /api/demo/* routes
DEMO_MODE=
# Invite code judges must enter at signup (optional)
JUDGE_SIGNUP_CODE=
# Shared password for seeded demo accounts
DEMO_SEED_PASSWORD=
# PayPal sandbox email for the seeded worker
SEED_WORKER_PAYPAL_EMAIL=
# PayPal sandbox email for the second spike worker
SPIKE_WORKER2_PAYPAL_EMAIL=
# PayPal sandbox buyer account email
SANDBOX_BUYER_EMAIL=
# PayPal sandbox REST app client id
PAYPAL_CLIENT_ID=
# PayPal sandbox REST app client secret
PAYPAL_CLIENT_SECRET=
# PayPal API base URL (sandbox: https://api-m.sandbox.paypal.com)
PAYPAL_API_BASE=
# PayPal webhook id used for signature verification
PAYPAL_WEBHOOK_ID=
# Cloudflare R2 account id
R2_ACCOUNT_ID=
# Cloudflare R2 access key id
R2_ACCESS_KEY_ID=
# Cloudflare R2 secret access key
R2_SECRET_ACCESS_KEY=
# Cloudflare R2 private bucket name
R2_BUCKET=
# Bearer token that guards the diagnostics route
DIAG_TOKEN=
# Public base URL of the deployed app (webhook and links)
APP_BASE_URL=
# Anthropic API key for the Claude judge
ANTHROPIC_API_KEY=
# Claude model id used by the judge
CLAUDE_JUDGE_MODEL=
# Google Gemini API key
GEMINI_API_KEY=
# Gemini model id used by the second judge
GEMINI_MODEL=
# Elastic Cloud Serverless endpoint URL
ELASTIC_URL=
# Elastic API key
ELASTIC_API_KEY=
# Zapier catch-hook URL for outbound notifications
ZAPIER_HOOK_URL=
